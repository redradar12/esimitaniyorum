{
  "name": "esimi-taniyorum",
  "version": "1.0.0",
  "private": true,
  "description": "Seni Tanıyorum - arkadaşlar ve çiftler için iki telefonla oynanan bilgi ve tanıma yarışması",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build:ui": "esbuild src/visuals.js --bundle --minify --format=iife --target=es2020 --legal-comments=inline --outfile=public/visuals.bundle.js",
    "test": "node test/flow.js",
    "gorsel": "node test/visual.js",
    "sorular": "node test/browse.js",
    "asmaca": "node test/hangman.js",
    "asmaca-ui": "node test/hangman-ui.js",
    "dogruyanlis": "node test/truefalse.js",
    "dogruyanlis-ui": "node test/truefalse-ui.js",
    "ses": "node test/voice.js",
    "ses-ui": "node test/voice-ui.js",
    "ciftler": "node test/team.js",
    "ciftler-ui": "node test/team-ui.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.22.3",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "gsap": "^3.15.0",
    "puppeteer-core": "^25.16.0",
    "socket.io-client": "^4.8.4",
    "three": "^0.187.0"
  }
